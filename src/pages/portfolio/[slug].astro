---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, relatedPosts, isPortfolio, primaryCategory } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && isPortfolio({ data } as any));
  const all = await getPublishedPosts();

  return posts.filter((post) => primaryCategory(post) === 'Portfolio').map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, all, 3) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout post={post} headings={headings} related={related}>
  <Content />
</ArticleLayout>
