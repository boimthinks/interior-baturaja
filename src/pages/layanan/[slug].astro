---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { SERVICES } from '../../data/services';
import { getPublishedPosts, isBlog } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return SERVICES.map((service) => {
    const related = posts
      .filter(
        (p) =>
          isBlog(p) &&
          p.data.tags.some((t) => service.relatedTags.includes(t))
      )
      .slice(0, 3);
    return { params: { slug: service.slug }, props: { service, related } };
  });
}

const { service, related } = Astro.props;
---

<ServiceLayout service={service} related={related} />
