---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, relatedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.category === 'Blog');
  const all = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, all, 4) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout post={post} headings={headings} related={related}>
  <Content />
</ArticleLayout>
