---
/**
 * Visual utama: memakai foto bila tersedia, atau placeholder "blueprint"
 * bergaya arsitektural bila aset foto belum ada. Rasio default 4:3.
 */
interface Props {
  src?: string;
  alt: string;
  ratio?: string;
  class?: string;
  eager?: boolean;
  label?: string;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  class: className = '',
  eager = false,
  label = 'Dokumentasi proyek',
} = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      class:list={['ph-img', className]}
      style={`aspect-ratio:${ratio}`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
    />
  ) : (
    <div
      class:list={['visual-ph', className]}
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={alt}
    >
      <svg class="visual-grid" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <pattern id="grid" width="25" height="25" patternUnits="userSpaceOnUse">
            <path d="M 25 0 L 0 0 0 25" fill="none" stroke="rgba(30,64,175,0.10)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="400" height="300" fill="url(#grid)" />
      </svg>
      <div class="visual-content">
        <svg viewBox="0 0 48 48" class="visual-icon" aria-hidden="true">
          <path d="M6 22 24 8l18 14v18a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M18 42V28h12v14" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 24h24" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span>{label}</span>
        <small>Visual proyek Interior Baturaja</small>
      </div>
    </div>
  )
}

<style>
  .visual-ph {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(30, 64, 175, 0.14), transparent 55%),
      radial-gradient(110% 110% at 100% 100%, rgba(184, 145, 80, 0.18), transparent 55%),
      linear-gradient(135deg, #eef2f9, #e4eaf4);
    border: 1px solid rgba(30, 64, 175, 0.12);
    color: var(--c-primary-d);
    width: 100%;
  }
  .visual-grid { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.9; }
  .visual-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    padding: 20px;
  }
  .visual-icon { width: 46px; height: 46px; color: var(--c-primary); opacity: 0.8; }
  .visual-content span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--c-fg);
    max-width: 26ch;
    line-height: 1.3;
  }
  .visual-content small {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
</style>
